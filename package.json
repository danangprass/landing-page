    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.6.0",
    "agentic-flow": "^2.0.7",
    "eslint": "^10.2.1",
    "jsdom": "^29.0.2",
