{
  "name": "electronics-store",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --no-error-on-unmatched-pattern",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "pb:types": "pocketbase-typegen --url ${PUBLIC_PB_URL:-http://localhost:8090} --email ${PB_ADMIN_EMAIL:-admin@example.com} --password ${PB_ADMIN_PASSWORD:-password} --out src/lib/pb-types.ts",
    "test:unit": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-auto": "^6.0.0",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "eslint": "^10.2.1",
    "jsdom": "^29.0.2",
    "pocketbase-typegen": "^1.4.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "type": "module",
  "dependencies": {
    "pocketbase": "^0.26.8"
  }
}