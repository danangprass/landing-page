    "@tailwindcss/vite": "^4.0.0",
    "pocketbase-typegen": "^1.4.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "type": "module",
  "dependencies": {
    "pocketbase": "^0.26.8"
