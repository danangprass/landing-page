# PocketBase server URL (server-side, not exposed to client)
PB_URL=http://localhost:8090

# PocketBase admin credentials (used only for dev tooling, e.g. npm run pb:types)
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme

# PocketBase public URL (exposed to client, must be prefixed with PUBLIC_)
PUBLIC_PB_URL=http://localhost:8090

# Midtrans Snap configuration (server-side)
MIDTRANS_MERCHANT_ID=
MIDTRANS_SERVER_KEY=

# Midtrans Snap client key (exposed to client for Snap.js)
PUBLIC_MIDTRANS_CLIENT_KEY=
